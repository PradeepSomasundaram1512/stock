# ============================================
# DAILY TRADING BOT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your credentials

# ============================================
# EMAIL NOTIFICATIONS (Recommended - FREE!)
# ============================================
EMAIL_ENABLED=true
EMAIL_ADDRESS=your.email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here
RECIPIENT_EMAIL=your.email@gmail.com

# Gmail SMTP Settings (default)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# For other email providers:
# Outlook: smtp-mail.outlook.com:587
# Yahoo: smtp.mail.yahoo.com:587

# ============================================
# SMS NOTIFICATIONS (Optional - Paid)
# ============================================
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
YOUR_PHONE_NUMBER=+1234567890

# ============================================
# API KEYS (Required for analysis)
# ============================================

# OpenAI API Key (for AI analysis)
OPENAI_API_KEY=your_openai_api_key_here

# OR use Anthropic Claude
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-sonnet-20241022

# ============================================
# NEWS APIs (Optional but recommended)
# ============================================

# NewsAPI (Free: 100 requests/day)
# Get key from: https://newsapi.org
NEWSAPI_API_KEY=your_newsapi_key_here

# Finnhub (Free: 60 calls/minute)
# Get key from: https://finnhub.io
FINNHUB_API_KEY=your_finnhub_key_here

# Alpha Vantage (Free: 25 calls/day)
# Get key from: https://www.alphavantage.co
ALPHA_VANTAGE_API_KEY=your_alphavantage_key_here

# ============================================
# TAVILY SEARCH (Optional)
# ============================================
TAVILY_API_KEY=your_tavily_key_here

# ============================================
# LLM CONFIGURATION
# ============================================
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# ============================================
# TRADING PARAMETERS
# ============================================

# Risk thresholds
HIGH_VOLATILITY_THRESHOLD=0.05
EXTREME_VOLATILITY_THRESHOLD=0.10

# Minimum confidence for alerts (0.0 to 1.0)
MIN_BUY_CONFIDENCE=0.65
MIN_SELL_CONFIDENCE=0.65

# ============================================
# HOW TO GET GMAIL APP PASSWORD
# ============================================
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Select "Mail" and your device
# 3. Copy the 16-character password (remove spaces)
# 4. Paste as EMAIL_PASSWORD above
#
# Note: Regular Gmail password won't work!
# You MUST use an App Password

# ============================================
# HOW TO GET TWILIO CREDENTIALS (Optional)
# ============================================
# 1. Sign up at https://www.twilio.com
# 2. Get $15 free trial credit
# 3. Buy a phone number ($1/month)
# 4. Find Account SID and Auth Token in dashboard
# 5. SMS costs ~$0.0075 per message

# ============================================
# QUICK START
# ============================================
# 1. Copy this file to .env
# 2. Add your email and Gmail app password
# 3. Add your OpenAI API key
# 4. Save the file
# 5. Run: python daily_trader.py scan
