# LLM API Keys (choose one or both)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Provider (openai or anthropic)
LLM_PROVIDER=openai

# Model configuration
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.3

# Vector DB configuration
VECTOR_DB_TYPE=faiss
VECTOR_DB_PATH=./data/vector_store

# Application settings
LOG_LEVEL=INFO
DEFAULT_TICKER=AAPL
DEFAULT_PERIOD=6mo
DEFAULT_INTERVAL=1d

# ============================================
# NOTIFICATION SETTINGS
# ============================================

# Discord Alerts (100% FREE - RECOMMENDED!)
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=

# Voice Alerts (uses text-to-speech on your computer)
VOICE_ENABLED=false
VOICE_RATE=150
VOICE_VOLUME=1.0

# WhatsApp Alerts (via Twilio - FREE sandbox)
WHATSAPP_ENABLED=false
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
YOUR_WHATSAPP_NUMBER=

# SMS Alerts (via Twilio - costs $0.0075 per message)
SMS_ENABLED=false
TWILIO_PHONE_NUMBER=

# Email Alerts (FREE)
EMAIL_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=

# Twilio credentials (for SMS and WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
